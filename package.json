{
  "name": "istanbul3d",
  "version": "1.0.0",
  "description": "Local-first viewer + repair workflow for SHARP + FLUX",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "dev:env": "tsx --env-file=.env apps/server/src/index.ts",
    "bootstrap:ml-sharp": "bash scripts/bootstrap-ml-sharp.sh",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/server/src/index.js",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://evanbbb@bitbucket.org/evanbbb/istanbul3d.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://bitbucket.org/evanbbb/istanbul3d/issues"
  },
  "homepage": "https://bitbucket.org/evanbbb/istanbul3d#readme",
  "dependencies": {
    "@fal-ai/client": "^1.9.1",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
